#!/usr/bin/env bash
set -u

manager="$HOME/.config/quickshell/overview/settings-panel/settings.py"
state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/aarav-hyprland"
log="$state_dir/aarav-settings.log"

mkdir -p "$state_dir"

if [[ ! -f "$manager" ]]; then
    notify-send \
        -u critical \
        "Aarav Settings unavailable" \
        "The settings panel is not installed."
    exit 1
fi

: > "$log"

if ! python "$manager" open >>"$log" 2>&1; then
    notify-send \
        -u critical \
        "Aarav Settings failed" \
        "Open $log for the startup error."
    exit 1
fi
