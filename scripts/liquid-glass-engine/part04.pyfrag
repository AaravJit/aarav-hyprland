    background: alpha(@primary_container, 0.78);
    border-color: alpha(@primary, 0.62);
    box-shadow:
        0 18px 46px alpha(@shadow, 0.42),
        inset 0 1px 0 alpha(@on_primary_container, 0.15);
}

button:active {
    background: alpha(@primary, 0.74);
    color: @on_primary;
}

button image {
    background: transparent;
    border: none;
    box-shadow: none;
    margin-bottom: 11px;
}

button label {
    color: inherit;
    font-family: "Noto Sans", "Symbols Nerd Font Mono", sans-serif;
    font-size: 18px;
    font-weight: 700;
}
'''
    atomic_write(CONFIG / "nwg-bar/style.css", style)


def write_hyprlock(p: dict[str, str]) -> None:
    colors = f'''$lock_primary = {rgba(p["primary"], 0.96)}
$lock_tertiary = {rgba(p["tertiary"], 0.96)}

$lock_primary_container = {rgba(p["primary_container"], 0.82)}
$lock_on_primary_container = {rgba(p["on_primary_container"], 1.0)}

$lock_surface = {rgba(p["surface"], 1.0)}
$lock_panel = {rgba(p["surface_container"], 0.66)}
$lock_panel_high = {rgba(p["surface_container_high"], 0.74)}

$lock_text = {rgba(p["on_surface"], 1.0)}
$lock_muted = {rgba(p["on_surface_variant"], 0.94)}
$lock_outline = {rgba(p["on_surface"], 0.18)}

$lock_error = {rgba(p["error"], 0.96)}
$lock_caps = {rgba(p["tertiary"], 0.96)}
'''
    atomic_write(CONFIG / "hypr/hyprlock-colors.conf", colors)

    monitor = ""
    try:
        machine = json.loads((CONFIG / "aarav-hyprland/machine.json").read_text())
        monitor = str(machine.get("monitor", ""))
    except (OSError, json.JSONDecodeError):
        pass

    conf = f'''source = {HOME}/.config/hypr/hyprlock-colors.conf

$font = Noto Sans

general {{
    hide_cursor = true
    ignore_empty_input = true
    immediate_render = true
    fail_timeout = 1600
}}

animations {{
    enabled = true
    bezier = liquid, 0.16, 1, 0.30, 1
    animation = fadeIn, 1, 4.8, liquid
    animation = fadeOut, 1, 3.4, liquid
    animation = inputFieldDots, 1, 2.8, liquid
    animation = inputFieldColors, 1, 3.2, liquid
}}

background {{
    monitor = {monitor}
    path = screenshot
    color = $lock_surface
    blur_passes = 5
    blur_size = 11
    noise = 0.008
    contrast = 0.94
    brightness = 0.50
    vibrancy = 0.20
    vibrancy_darkness = 0.05
}}

label {{
    monitor = {monitor}
    text = $TIME12
    color = $lock_text
    font_size = 96
    font_family = $font
    shadow_passes = 3
    shadow_size = 8
    shadow_color = rgba(0, 0, 0, 0.65)
    shadow_boost = 1.18
    position = 0, 252
    halign = center
    valign = center
    zindex = 2
}}

label {{
    monitor = {monitor}
    text = cmd[update:60000] date "+%A, %B %d"
    color = $lock_muted
    font_size = 20
    font_family = $font
    shadow_passes = 2
    shadow_size = 5
    shadow_color = rgba(0, 0, 0, 0.60)
    position = 0, 164
    halign = center
    valign = center
    zindex = 2
}}

shape {{
    monitor = {monitor}
    size = 454, 286
    color = $lock_panel
    rounding = 36
    border_size = 1
    border_color = $lock_outline
    shadow_passes = 4
    shadow_size = 24
    shadow_color = rgba(0, 0, 0, 0.55)
    shadow_boost = 1.30
    position = 0, -22
    halign = center
    valign = center
    zindex = 0
}}

shape {{
    monitor = {monitor}
    size = 82, 82
    color = $lock_primary_container
    rounding = -1
    border_size = 1
    border_color = $lock_primary
    shadow_passes = 3
    shadow_size = 13
    shadow_color = rgba(0, 0, 0, 0.45)
    position = 0, 87
    halign = center
    valign = center
    zindex = 2
}}

label {{
    monitor = {monitor}
    text = A
    color = $lock_on_primary_container
    font_size = 31
    font_family = $font
    position = 0, 88
    halign = center
    valign = center
    zindex = 3
}}

label {{
    monitor = {monitor}
    text = $USER
    color = $lock_text
    font_size = 15
    font_family = $font
    position = 0, 28
    halign = center
    valign = center
    zindex = 3
}}

input-field {{
    monitor = {monitor}
    size = 356, 62
    outline_thickness = 1
    dots_size = 0.22
    dots_spacing = 0.30
    dots_center = true
    dots_rounding = -1
    outer_color = $lock_primary $lock_tertiary 45deg
    inner_color = $lock_panel_high
    font_color = $lock_text
    check_color = $lock_tertiary
    check_text = Authenticating...
    fail_color = $lock_error
    fail_text = $FAIL
    capslock_color = $lock_caps
    numlock_color = -1
    bothlock_color = $lock_error
    invert_numlock = false
    placeholder_text = Enter password
    fade_on_empty = false
    hide_input = false
    rounding = 22
    shadow_passes = 3
    shadow_size = 11
    shadow_color = rgba(0, 0, 0, 0.42)
    position = 0, -48
    halign = center
    valign = center
    zindex = 3
}}

label {{
    monitor = {monitor}
    text = Enter to unlock  •  Esc clears input
    color = $lock_muted
    font_size = 12
    font_family = $font
    position = 0, -119
    halign = center
    valign = center
    zindex = 3
}}

label {{
    monitor = {monitor}
    text = Locked  •  Hyprland
    color = $lock_muted
    font_size = 12
    font_family = $font
    position = 28, 24
    halign = left
    valign = bottom
    zindex = 2
}}
'''
    atomic_write(CONFIG / "hypr/hyprlock.conf", conf)


def write_kitty(p: dict[str, str]) -> None:
    theme = f'''foreground {p["on_surface"]}
background {p["surface"]}
selection_foreground {p["on_primary_container"]}
selection_background {p["primary_container"]}
cursor {p["primary"]}
cursor_text_color {p["on_primary"]}
url_color {p["tertiary"]}
active_border_color {p["primary"]}
inactive_border_color {p["outline_variant"]}
bell_border_color {p["error"]}

color0 {p["surface_container_lowest"]}
color1 {p["error"]}
color2 {p["tertiary"]}
color3 {p["primary"]}
color4 {p["secondary"]}
color5 {p["primary"]}
color6 {p["secondary"]}
color7 {p["on_surface"]}
color8 {p["outline"]}
color9 {p["error"]}
color10 {p["tertiary"]}
color11 {p["primary"]}
color12 {p["secondary"]}
color13 {p["primary"]}
color14 {p["secondary"]}
color15 {p["on_background"]}
'''
    atomic_write(CONFIG / "kitty/matugen.conf", theme)
    kitty_conf = '''# Aarav Liquid Glass terminal
include matugen.conf

background_opacity 0.82
dynamic_background_opacity yes
window_padding_width 12
confirm_os_window_close 0
'''
    atomic_write(CONFIG / "kitty/kitty.conf", kitty_conf)


def write_overview(p: dict[str, str]) -> None:
    appearance = f'''pragma Singleton
import QtQuick
