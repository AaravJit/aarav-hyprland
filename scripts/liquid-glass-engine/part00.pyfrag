VERSION = 2
HOME = Path.home()
CONFIG = HOME / ".config"
STATE_DIR = Path(os.environ.get("XDG_STATE_HOME", HOME / ".local/state")) / "aarav-hyprland"
PALETTE_FILE = CONFIG / "aarav-hyprland/liquid-glass-colors.json"
SETTINGS_FILE = STATE_DIR / "settings.json"
APPLY_STATE = STATE_DIR / "liquid-glass-state.json"

FALLBACK: dict[str, str] = {
    "primary": "#ffb598",
    "on_primary": "#501900",
    "primary_container": "#8f4828",
    "on_primary_container": "#ffffff",
    "secondary": "#a0cfd4",
    "on_secondary": "#003135",
    "tertiary": "#8fd4c3",
    "on_tertiary": "#00382f",
    "background": "#0c1512",
    "on_background": "#dbe5df",
    "surface": "#0c1512",
    "surface_variant": "#3f4945",
    "surface_container_lowest": "#07100d",
    "surface_container_low": "#151e1b",
    "surface_container": "#1b2421",
    "surface_container_high": "#252e2b",
    "surface_container_highest": "#303936",
    "on_surface": "#dbe5df",
    "on_surface_variant": "#b8cbc3",
    "outline": "#83958e",
    "outline_variant": "#4e5f59",
    "error": "#ffb4ab",
    "on_error": "#690005",
    "error_container": "#93000a",
