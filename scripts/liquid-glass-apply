#!/usr/bin/env python3
import subprocess
import sys
from pathlib import Path

parts_dir = Path(__file__).with_name("liquid-glass-engine")
parts = sorted(parts_dir.glob("part*.pyfrag"))

if not parts:
    raise SystemExit(f"Liquid Glass engine parts are missing: {parts_dir}")

source = "".join(path.read_text(encoding="utf-8") for path in parts)
namespace = {
    "__name__": "__main__",
    "__file__": str(Path(__file__).resolve()),
}
exec(compile(source, str(Path(__file__).resolve()), "exec"), namespace)

# Keep Quickshell's required AppId pragma as the first source line. The
# renderer's idempotence marker must follow it or settings_apply.py rejects
# the assembled panel as incomplete.
panel = Path.home() / ".config/quickshell/overview/settings-panel"
first_part = panel / "shell.part01.qml"
marker = "// Liquid Glass transformed\n"
pragma = "//@ pragma AppId aarav-settings\n"

if first_part.is_file():
    text = first_part.read_text(encoding="utf-8")
    broken_prefix = marker + pragma
    if text.startswith(broken_prefix):
        first_part.write_text(
            pragma + marker + text[len(broken_prefix):],
            encoding="utf-8",
        )
        generated = panel / ".generated-shell.qml"
        if generated.exists():
            generated.unlink()

# The three most-used applications share the same Matugen palette as the
# desktop. Keep this separate from the shell renderer so missing apps never
# prevent Hyprland itself from applying successfully.
apps = Path(__file__).with_name("liquid-glass-apps")
if apps.is_file():
    forwarded: list[str] = []
    if "--force" in sys.argv:
        forwarded.append("--force")
    if "--quiet" in sys.argv:
        forwarded.append("--quiet")
    subprocess.run([str(apps), *forwarded], check=False)
