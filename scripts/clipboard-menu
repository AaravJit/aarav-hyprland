#!/usr/bin/env bash
set -euo pipefail

selection="$(
    cliphist list |
        fuzzel \
            --dmenu \
            --no-icons \
            --with-nth=2 \
            --prompt='' \
            --placeholder='Search clipboard' \
            --width=56 \
            --lines=9 \
            --horizontal-pad=18 \
            --vertical-pad=12 \
            --inner-pad=8 \
            --line-height=24px \
            --minimal-lines
)" || exit 0

[[ -n "$selection" ]] || exit 0

printf '%s\n' "$selection" |
    cliphist decode |
    wl-copy

notify-send \
    "Clipboard restored" \
    "The selected item is ready to paste."
