#!/usr/bin/env bash
set -euo pipefail

selection="$(
    cliphist list |
        fuzzel \
            --dmenu \
            --no-icons \
            --with-nth=2 \
            --message='Clipboard history' \
            --prompt='  ' \
            --placeholder='Search copied text' \
            --width=64 \
            --lines=11 \
            --minimal-lines
)" || exit 0

[[ -n "$selection" ]] || exit 0

printf '%s\n' "$selection" |
    cliphist decode |
    wl-copy

notify-send \
    "Clipboard restored" \
    "The selected item is ready to paste."
