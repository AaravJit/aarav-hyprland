#!/usr/bin/env bash
set -euo pipefail

runtime_dir="${XDG_RUNTIME_DIR:-/tmp}"
lock_file="$runtime_dir/aarav-hypr-safe-reload.lock"

exec 9>"$lock_file"

if ! flock -n 9; then
    echo "Another safe reload is already running."
    exit 1
fi

temporary="$(mktemp -d)"
trap 'rm -rf "$temporary"' EXIT

cp -a \
    "$HOME/.config/hypr" \
    "$temporary/hypr"

"$HOME/.local/bin/hypr-snapshot" --quiet

echo "Checking Lua syntax..."

while IFS= read -r -d '' lua_file; do
    if ! luac -p "$lua_file"; then
        echo
        echo "Reload cancelled. Syntax error in:"
        echo "$lua_file"

        hyprctl notify \
            3 \
            3500 \
            "rgb(ff6b6b)" \
            "Reload cancelled: Lua syntax error" \
            >/dev/null 2>&1 || true

        exit 1
    fi
done < <(
    find "$HOME/.config/hypr" \
        -type f \
        -name '*.lua' \
        -print0
)

hyprctl reload >/dev/null
sleep 0.8

errors="$(
    hyprctl configerrors 2>&1 |
        sed '/^[[:space:]]*$/d'
)"

if [[ -z "$errors" ]]; then
    echo "Hyprland reloaded successfully."

    hyprctl notify \
        0 \
        2200 \
        "rgb(8fd4c3)" \
        "Hyprland safely reloaded" \
        >/dev/null 2>&1 || true

    exit 0
fi

echo "Hyprland rejected the configuration:"
printf '%s\n' "$errors"
echo
echo "Restoring the previous working configuration..."

stamp="$(date +%F-%H%M%S)"
broken="$HOME/.config/hypr-broken-$stamp"

mv "$HOME/.config/hypr" "$broken"
cp -a "$temporary/hypr" "$HOME/.config/hypr"

hyprctl reload >/dev/null 2>&1 || true
sleep 0.5

echo "Previous configuration restored."
echo "Rejected files were preserved at:"
echo "$broken"

hyprctl notify \
    3 \
    4500 \
    "rgb(ff6b6b)" \
    "Broken config rolled back automatically" \
    >/dev/null 2>&1 || true

exit 1
