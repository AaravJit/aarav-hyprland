#!/usr/bin/env python3
from __future__ import annotations

import argparse
import hashlib
import json
import os
import shutil
import subprocess
import tempfile
from pathlib import Path
from typing import Any

HOME = Path.home()
CONFIG = HOME / ".config"
STATE = Path(os.environ.get("XDG_STATE_HOME", HOME / ".local/state")) / "aarav-hyprland"
PALETTE_PATH = CONFIG / "aarav-hyprland/liquid-glass-colors.json"
STATE_PATH = STATE / "liquid-glass-apps.json"

FALLBACK = {
    "primary": "#ffb598",
    "on_primary": "#501900",
    "primary_container": "#8f4828",
    "on_primary_container": "#ffffff",
    "secondary": "#a0cfd4",
    "on_secondary": "#003135",
    "tertiary": "#8fd4c3",
    "on_tertiary": "#00382f",
    "background": "#0c1512",
    "on_background": "#dbe5df",
    "surface": "#0c1512",
    "surface_variant": "#3f4945",
    "surface_container_lowest": "#07100d",
    "surface_container_low": "#151e1b",
    "surface_container": "#1b2421",
    "surface_container_high": "#252e2b",
    "surface_container_highest": "#303936",
    "on_surface": "#dbe5df",
    "on_surface_variant": "#b8cbc3",
    "outline": "#83958e",
    "outline_variant": "#4e5f59",
    "error": "#ffb4ab",
    "on_error": "#690005",
    "error_container": "#93000a",
    "on_error_container": "#ffdad6",
    "shadow": "#000000",
}


def atomic_write(path: Path, text: str, mode: int = 0o644) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    with tempfile.NamedTemporaryFile("w", encoding="utf-8", dir=path.parent, delete=False) as handle:
        handle.write(text)
        temporary = Path(handle.name)
    temporary.chmod(mode)
    os.replace(temporary, path)


def load_json(path: Path) -> dict[str, Any]:
    try:
        value = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return {}
    return value if isinstance(value, dict) else {}


def load_palette() -> dict[str, str]:
    palette = dict(FALLBACK)
    raw = load_json(PALETTE_PATH)
    for key, fallback in FALLBACK.items():
        value = str(raw.get(key, fallback)).strip().lower()
        if len(value) == 7 and value.startswith("#"):
            palette[key] = value
    return palette


def rgb(value: str) -> tuple[int, int, int]:
    value = value.lstrip("#")
    return tuple(int(value[index:index + 2], 16) for index in (0, 2, 4))


def rgba(value: str, alpha: float) -> str:
    red, green, blue = rgb(value)
    return f"rgba({red}, {green}, {blue}, {alpha:.3f})"


def bare(value: str) -> str:
    return value.lstrip("#")


