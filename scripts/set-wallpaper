#!/usr/bin/env bash
set -euo pipefail

settings_manager="$HOME/.config/quickshell/overview/settings-panel/settings.py"
declare -a roots=()
declare -A seen_roots=()

add_root() {
    local directory="$1"
    [[ -d "$directory" ]] || return 0
    [[ -z "${seen_roots[$directory]:-}" ]] || return 0
    seen_roots["$directory"]=1
    roots+=("$directory")
}

if [[ -f "$settings_manager" ]]; then
    while IFS= read -r -d '' directory; do
        add_root "$directory"
    done < <(
        python "$settings_manager" wallpaper-roots --null
    )
fi

if (( ${#roots[@]} == 0 )); then
    for directory in \
        "__WALLPAPER_DIR__" \
        "$HOME/Pictures" \
        "$HOME/Downloads"
    do
        add_root "$directory"
    done
fi

if (( ${#roots[@]} == 0 )); then
    notify-send \
        "Wallpaper picker" \
        "No valid wallpaper directories are configured. Open Aarav Settings with Super + comma."
    exit 1
fi

selection="$(
    find "${roots[@]}" \
        -type f \
        \( \
            -iname '*.png'  -o \
            -iname '*.jpg'  -o \
            -iname '*.jpeg' -o \
            -iname '*.webp' \
        \) \
        -print0 2>/dev/null |
        sort -z |
        while IFS= read -r -d '' path; do
            printf '%s\t%s\n' \
                "$path" \
                "$(basename -- "$path")"
        done |
        fuzzel \
            --dmenu \
            --no-icons \
            --with-nth=2 \
            --accept-nth=1 \
            --only-match \
            --prompt='' \
            --placeholder='Search wallpapers' \
            --width=60 \
            --lines=9 \
            --horizontal-pad=18 \
            --vertical-pad=12 \
            --inner-pad=8 \
            --line-height=24px \
            --minimal-lines
)" || exit 0

[[ -f "$selection" ]] || exit 0

notify-send \
    "Generating desktop theme" \
    "Extracting colors from $(basename "$selection")"

declare -a theme_args=(
    --mode dark
    --type scheme-expressive
    --source-color-index 0
)

if [[ -f "$settings_manager" ]]; then
    mapfile -d '' -t configured_theme_args < <(
        python "$settings_manager" theme-args --null
    )

    if (( ${#configured_theme_args[@]} > 0 )); then
        theme_args=("${configured_theme_args[@]}")
    fi
fi

if ! matugen image "$selection" "${theme_args[@]}"; then
    notify-send \
        -u critical \
        "Theme generation failed" \
        "The existing wallpaper and theme were kept."
    exit 1
fi

if [[ -f "$settings_manager" ]]; then
    python "$settings_manager" \
        apply \
        --component launcher \
        --quiet
fi

if ! fuzzel --check-config >/dev/null 2>&1; then
    notify-send \
        -u critical \
        "Launcher theme failed" \
        "Matugen produced an invalid Fuzzel configuration."
    exit 1
fi

extension="${selection##*.}"
extension="${extension,,}"

rm -f "$HOME"/.config/hypr/wallpaper-current.*

wallpaper="$HOME/.config/hypr/wallpaper-current.$extension"
ln -s "$selection" "$wallpaper"

cat > "$HOME/.config/hypr/hyprpaper.conf" <<CONFIG
splash = false
ipc = true

wallpaper {
    monitor = __MONITOR__
    path = $wallpaper
    fit_mode = cover
}
CONFIG

systemctl --user restart hyprpaper.service

notify-send \
    "Desktop theme applied" \
    "$(basename "$selection")"
