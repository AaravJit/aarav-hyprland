#!/usr/bin/env python3

import json
import subprocess
import sys
from pathlib import Path


def run(args: list[str]) -> str:
    try:
        result = subprocess.run(
            args,
            check=False,
            capture_output=True,
            text=True,
            timeout=2,
        )
        if result.returncode == 0:
            return result.stdout.strip()
    except (OSError, subprocess.TimeoutExpired):
        pass

    return ""


def shorten(text: str, limit: int) -> str:
    text = " ".join(text.split())

    if len(text) <= limit:
        return text

    return text[: limit - 1].rstrip() + "…"


def spotify_player() -> str | None:
    players = run(["playerctl", "--list-all"]).splitlines()

    for player in players:
        if player.lower().startswith("spotify"):
            return player

    return None


def metadata(player: str, key: str) -> str:
    return run([
        "playerctl",
        "--player",
        player,
        "metadata",
        key,
    ])


def perform_action(action: str) -> None:
    player = spotify_player()

    if player is None:
        # Clicking the center capsule while Spotify is closed launches it.
        if action == "toggle":
            launcher = Path.home() / ".local/bin/launch-app"

            subprocess.Popen(
                ["uwsm", "app", "--", str(launcher), "spotify"],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                start_new_session=True,
            )

        return

    actions = {
        "toggle": "play-pause",
        "next": "next",
        "previous": "previous",
    }

    player_action = actions.get(action)

    if player_action:
        subprocess.run(
            ["playerctl", "--player", player, player_action],
            check=False,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )


def media_payload() -> dict[str, object] | None:
    player = spotify_player()

    if player is None:
        return None

    status = run([
        "playerctl",
        "--player",
        player,
        "status",
    ]).lower()

    title = metadata(player, "xesam:title")
    artist = metadata(player, "xesam:artist")
    album = metadata(player, "xesam:album")

    if not title or status not in {"playing", "paused"}:
        return None

    if artist:
        display = f"  {artist} — {title}"
    else:
        display = f"  {title}"

    tooltip_lines = [
        "Spotify",
        f"Status: {status.title()}",
        f"Track: {title}",
    ]

    if artist:
        tooltip_lines.append(f"Artist: {artist}")

    if album:
        tooltip_lines.append(f"Album: {album}")

    tooltip_lines.extend([
        "",
        "Left click: Play/Pause",
        "Right click: Next",
        "Middle click: Previous",
    ])

    return {
        "text": shorten(display, 74),
        "tooltip": "\n".join(tooltip_lines),
        "class": (
            "media-playing"
            if status == "playing"
            else "media-paused"
        ),
        "alt": status,
    }


def active_window_payload() -> dict[str, object]:
    raw = run(["hyprctl", "activewindow", "-j"])

    try:
        window = json.loads(raw) if raw else {}
    except json.JSONDecodeError:
        window = {}

    window_class = str(window.get("class") or "")
    title = str(window.get("title") or "")

    icons = {
        "kitty": "",
        "zen": "󰖟",
        "Spotify": "",
        "discord": "",
        "steam": "",
        "com.heroicgameslauncher.hgl": "󰊴",
        "org.kde.dolphin": "",
        "dolphin": "",
        "pavucontrol": "",
    }

    icon = icons.get(window_class, "󰖯")

    if title:
        text = f"{icon}  {shorten(title, 68)}"
        tooltip = f"{title}\n\nClass: {window_class or 'Unknown'}"
    else:
        text = "󰇄  Desktop"
        tooltip = "No active window"

    return {
        "text": text,
        "tooltip": tooltip,
        "class": "window",
        "alt": window_class or "desktop",
    }


def main() -> None:
    if len(sys.argv) > 1:
        perform_action(sys.argv[1])
        return

    payload = media_payload() or active_window_payload()
    print(json.dumps(payload, ensure_ascii=False))


if __name__ == "__main__":
    main()
